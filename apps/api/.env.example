PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ticketledger_db?schema=public"
REDIS_URL="redis://localhost:6379"

# Required in production (the server refuses to sign tokens without it). Access tokens last 15 minutes;
# refresh tokens last 7 days in an httpOnly cookie.
JWT_SECRET="change-me-to-a-long-random-string"
# Set to "none" when the frontend and API are on different sites (requires HTTPS)
COOKIE_SAMESITE="lax"
# Max requests per minute per IP on /login, /signup, /resend-otp, /forgot-password (default 5).
# Raise it locally when running the HTTP test scripts against the dev server.
AUTH_RATE_LIMIT_MAX=5

ML_SERVICE_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:5173"

# Blockchain (Polygon Amoy Testnet)
POLYGON_RPC_URL="https://rpc-amoy.polygon.technology"
NFT_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
MARKETPLACE_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
DEPLOYER_PRIVATE_KEY=""

# Cloudinary
CLOUDINARY_CLOUD_NAME="ticketledger"
CLOUDINARY_API_KEY="mock_key"
CLOUDINARY_API_SECRET="mock_secret"

# Payments
STRIPE_SECRET_KEY="sk_test_mock_stripe_key"
JAZZCASH_MERCHANT_ID="mock_jazzcash_merchant"
JAZZCASH_PASSWORD="mock_jazzcash_password"
EASYPAISA_STORE_ID="mock_easypaisa_store"

# SMTP / Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
MAIL_FROM="TicketLedger <your-email@gmail.com>"
