PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ticketledger_db?schema=public"
REDIS_URL="redis://localhost:6379"

# Required in production (the server refuses to sign tokens without it). Access tokens last 15 minutes;
# refresh tokens last 7 days in an httpOnly cookie.
JWT_SECRET="change-me-to-a-long-random-string"
# Required in production: Ed25519 key for gate passes (PKCS#8 PEM, 
 for newlines). Development generates one in .keys/
# Generate: node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}))"
QR_SIGNING_PRIVATE_KEY=""
# Required in production: encrypts organizations' payout account and wallet numbers at rest. Any long random
# string; keep it with your database backups (changing it makes stored numbers unreadable).
FINANCE_ENCRYPTION_KEY=""
# Set to "none" when the frontend and API are on different sites (requires HTTPS)
COOKIE_SAMESITE="lax"
# Max requests per minute per IP on /login, /signup, /resend-otp, /forgot-password (default 5).
# Raise it locally when running the HTTP test scripts against the dev server.
AUTH_RATE_LIMIT_MAX=5

ML_SERVICE_URL="http://localhost:8000"
# Shared secret between the API and the ML service (required by the ML service when ML_ENV=production)
ML_SERVICE_TOKEN=""
# The rules answer if the ML service has not replied within this many ms
ML_TIMEOUT_MS=300
# Shadow models score in the background only (never decide). false stops the model calls; snapshots stay.
ML_SHADOW_ENABLED=true
# Feature snapshots of every prediction (training data). Independent of ML_SHADOW_ENABLED.
ML_SNAPSHOTS_ENABLED=true
# Training export (scripts/ml-export-datasets.mjs). Purchases only count with server-side LIVE payment evidence
# (services/paymentEvidence.js), never from a setting.
# Extra test / internal e-mail domains and ids to leave out (comma-separated)
ML_EXPORT_TEST_DOMAINS=""
ML_EXPORT_EXCLUDE_USERS=""
ML_EXPORT_EXCLUDE_EVENTS=""
FRONTEND_URL="http://localhost:5173"

# Blockchain (Polygon Amoy Testnet)
POLYGON_RPC_URL="https://rpc-amoy.polygon.technology"
NFT_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
MARKETPLACE_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
# NFT minting (src/config/chain.js). Three separate wallets:
#   contract owner  deploys and authorizes minters; its key (DEPLOYER_PRIVATE_KEY) stays off the API server
#   API minter      NFT_MINTER_PRIVATE_KEY: may only mint/invalidate; must be authorized and must NOT be the owner
#   custodian       PLATFORM_CUSTODIAN_WALLET: a wallet you control; receives NFTs of customers without a wallet
# Without NFT_MINTER_PRIVATE_KEY: simulation in development (tokens marked simulated), disabled in production.
# Hardhat's public test keys are refused except on a local chain (NFT_CHAIN_ID 31337).
POLYGON_AMOY_RPC="https://polygon-amoy-bor-rpc.publicnode.com"
NFT_CHAIN_ID=80002
TICKET_NFT_CONTRACT_ADDRESS=""
NFT_MINTER_PRIVATE_KEY=""
PLATFORM_CUSTODIAN_WALLET=""
# Testing / demo only: make the first N mint attempts of every ticket fail, to show the retry-and-alert path
NFT_MINT_FAIL_ATTEMPTS=0
DEPLOYER_PRIVATE_KEY=""

# Cloudinary
CLOUDINARY_CLOUD_NAME="ticketledger"
CLOUDINARY_API_KEY="mock_key"
CLOUDINARY_API_SECRET="mock_secret"

# Payments
STRIPE_SECRET_KEY="sk_test_mock_stripe_key"
JAZZCASH_MERCHANT_ID="mock_jazzcash_merchant"
JAZZCASH_PASSWORD="mock_jazzcash_password"
EASYPAISA_STORE_ID="mock_easypaisa_store"

# SMTP / Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
MAIL_FROM="TicketLedger <your-email@gmail.com>"

# Gate scanner device authentication (see docs/gate-operations-rollout.md)
# warn = migration (un-enrolled scanners still work and are counted), enforce = device token required,
# off = emergency rollback (tokens ignored). From the deadline on, warn and off behave as enforce.
GATE_DEVICE_AUTH=warn
GATE_DEVICE_AUTH_DEADLINE=2026-12-31T23:59:59Z
