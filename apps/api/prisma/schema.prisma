// TicketLedger Prisma Schema
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ORGANIZER
  GATE_STAFF
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
  FROZEN
  BLACKLISTED
}

enum OtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum InviteStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum EventType {
  CRICKET_MATCH
  FOOTBALL_MATCH
  KABADDI
  BOXING
  MUSIC_CONCERT
  MUSIC_FESTIVAL
  HOCKEY_MATCH
  QAWWALI
  THEATRE
  CONFERENCE
  GENERAL_ADMISSION
}

// What a Seat row represents: a numbered seat, an unnumbered general-admission place, or a table seat
enum SeatKind {
  SEAT
  GA_SLOT
  TABLE_SEAT
}

enum VenueLayoutStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EventStatus {
  DRAFT
  PRELAUNCH_ANALYSIS
  PENDING_APPROVAL // sent to TicketLedger admins; not public until approved
  REJECTED // returned by an admin with a comment; the organizer can fix and resubmit
  PUBLISHED
  PAUSED
  COMPLETED
  CANCELLED
}

enum SeatStatus {
  AVAILABLE
  LOCKED
  SOLD
  BLOCKED
}

enum OrderStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

enum PaymentMethod {
  STRIPE
  JAZZCASH
  EASYPAISA
  MOCK
}

enum TicketStatus {
  ACTIVE
  SCANNED
  TRANSFERRED
  RESOLD
  CANCELLED
}

enum GateScanResult {
  VALID_FIRST_SCAN
  ALREADY_SCANNED
  INVALID_SCAN
}

enum CheckInResult {
  GREEN
  YELLOW
  RED
}

enum ResaleStatus {
  ACTIVE
  SOLD
  CANCELLED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  phone         String?        @unique
  passwordHash  String
  name          String
  role          Role           @default(CUSTOMER)
  status        AccountStatus  @default(PENDING_VERIFICATION)
  walletAddress String?        @unique
  // Organizers: the company they own. Gate staff: the company whose events they work.
  companyId          String?
  memberOfCompany    Company?       @relation("CompanyMembers", fields: [companyId], references: [id], onDelete: SetNull)
  emailVerifiedAt    DateTime?
  otpCode            String?
  otpExpiresAt       DateTime?
  isVerified         Boolean        @default(false)
  city               String?        @default("Lahore")
  emailNotifications Boolean        @default(true)
  pushNotifications  Boolean        @default(true)
  smsNotifications   Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  company        Company?
  orders         Order[]
  otpCodes       OtpCode[]
  refreshTokens  RefreshToken[]
  invitesSent    StaffInvite[]           @relation("InvitesSent")
  staffAssignments    StaffEventAssignment[] @relation("StaffAssignments")
  assignmentsCreated  StaffEventAssignment[] @relation("AssignmentsCreated")
  tickets        Ticket[]
  scansPerformed GateScan[]
  checkInsPerformed CheckIn[] @relation("StaffCheckIns")
  ticketsCheckedIn  Ticket[]  @relation("TicketCheckIns")
  behaviorEvents BehaviorEvent[]
  notifications  Notification[]
  wishlistItems  WishlistItem[]
  auditLogs      AuditLog[]
  resaleListings ResaleListing[] @relation("SellerListings")
  transfersSent      TicketTransferHistory[] @relation("TransfersSent")
  transfersReceived  TicketTransferHistory[] @relation("TransfersReceived")
  waitlistEntries    Waitlist[]

  @@index([role])
  @@index([status])
  @@index([companyId])
}

model OtpCode {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId, purpose])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model StaffInvite {
  id          String       @id @default(uuid())
  email       String
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User         @relation("InvitesSent", fields: [invitedById], references: [id])
  tokenHash   String       @unique
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([email])
  @@index([companyId])
  @@index([eventId])
}

model StaffEventAssignment {
  staffId      String
  staff        User     @relation("StaffAssignments", fields: [staffId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User     @relation("AssignmentsCreated", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  @@id([staffId, eventId])
  @@index([eventId])
}

model Company {
  id              String        @id @default(uuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  ownerName       String
  phone           String
  email           String
  city            String
  ntnCnic         String
  documentUrl     String
  status          CompanyStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  events       Event[]
  members      User[]        @relation("CompanyMembers")
  staffInvites StaffInvite[]

  @@index([status])
}

model Event {
  id          String      @id @default(uuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String
  type        EventType
  status      EventStatus @default(DRAFT)
  date        DateTime
  time        String
  city        String
  venue       String
  // Exact venue location picked on the map by the organizer (home map pin, "Open in Google Maps")
  latitude        Float?
  longitude       Float?
  locationAddress String?
  // Where attendees reach the organizer about this event (falls back to the organizer's company email)
  contactEmail    String?
  bannerUrl   String?
  // Organizer-managed media (all optional; the web app falls back to bannerUrl / category artwork)
  cardImageUrl   String?
  galleryWideUrl String?
  // Admin review: set when the organizer submits and when an admin approves or rejects
  submittedAt    DateTime?
  approvedAt     DateTime?
  reviewedAt     DateTime?
  reviewedBy     String?
  reviewComment  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  galleryImages  EventGalleryImage[]
  venueLayouts   VenueLayout[]
  tiers          TicketTier[]
  seats          Seat[]
  orders         Order[]
  tickets        Ticket[]
  wishlistItems  WishlistItem[]
  behaviorEvents BehaviorEvent[]
  waitlist       Waitlist[]
  staffInvites     StaffInvite[]
  staffAssignments StaffEventAssignment[]

  @@index([city])
  @@index([type])
  @@index([status])
}

// Ordered photos for the event page's scrolling gallery strip
model EventGalleryImage {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url       String
  position  Int
  createdAt DateTime @default(now())

  @@index([eventId, position])
}

model TicketTier {
  id                String   @id @default(uuid())
  eventId           String
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name              String
  price             Decimal  @db.Decimal(10, 2)
  totalQuantity     Int
  availableQuantity Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  seats Seat[]

  @@index([eventId])
}

model Seat {
  id             String     @id @default(uuid())
  eventId        String
  event          Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tierId         String
  tier           TicketTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  section        String
  row            String
  seatNumber     String
  status         SeatStatus @default(AVAILABLE)
  lockedUntil    DateTime?
  lockedByUserId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Venue layout link (null for seats from the older grid generator)
  layoutKey      String?
  sectionKey     String?
  kind           SeatKind   @default(SEAT)
  tableKey       String?
  wholeTable     Boolean    @default(false)

  ticket Ticket?

  @@unique([eventId, section, row, seatNumber])
  @@unique([eventId, layoutKey])
  @@index([eventId, status])
  @@index([eventId, sectionKey])
  @@index([eventId, tableKey])
}

// Organizer-designed venue plan. One DRAFT per event is edited freely; publishing validates it against
// held/sold seats, syncs Seat rows and makes it the PUBLISHED version (the previous one is ARCHIVED).
model VenueLayout {
  id            String            @id @default(uuid())
  eventId       String
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status        VenueLayoutStatus @default(DRAFT)
  version       Int               @default(1)
  template      String?
  data          Json
  createdById   String?
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([eventId, status])
}

model Order {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  eventId       String
  event         Event         @relation(fields: [eventId], references: [id])
  totalAmount   Decimal       @db.Decimal(10, 2)
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(MOCK)
  paymentTxId   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tickets Ticket[]

  @@index([userId])
  @@index([status])
}

model Ticket {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventId         String
  event           Event         @relation(fields: [eventId], references: [id])
  seatId          String        @unique
  seat            Seat          @relation(fields: [seatId], references: [id])
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  price           Decimal       @db.Decimal(10, 2)
  status          TicketStatus  @default(ACTIVE)
  
  // Blockchain metadata
  tokenId         Int?
  txHash          String?
  contractAddress String?
  ownerWallet     String?
  
  // Dynamic secure QR metadata
  qrNonce         String        @default(uuid())
  qrIssuedAt      DateTime      @default(now())
  qrSignature     String?
  qrVersion       Int           @default(1) // +1 on every transfer / resale: the old owner's QR stops working
  // Short code printed under the QR for when the camera fails (rotated with qrVersion)
  manualCode      String?       @unique
  // Gate check-in (status ACTIVE = valid, SCANNED = used)
  checkedInAt     DateTime?
  checkedInById   String?
  checkedInBy     User?         @relation("TicketCheckIns", fields: [checkedInById], references: [id])
  gate            String?
  pdfUrl          String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  scans          GateScan[]
  checkIns       CheckIn[]
  resaleListings ResaleListing[]
  transferHistory TicketTransferHistory[]

  @@index([userId])
  @@index([eventId])
  @@index([status])
}

model ResaleListing {
  id             String       @id @default(uuid())
  ticketId       String
  ticket         Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sellerId       String
  seller         User         @relation("SellerListings", fields: [sellerId], references: [id])
  buyerId        String?
  originalPrice  Decimal      @db.Decimal(10, 2)
  resalePrice    Decimal      @db.Decimal(10, 2)
  maxResalePrice Decimal      @db.Decimal(10, 2) // enforced <= 1.10 * originalPrice
  status         ResaleStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([ticketId])
}

model GateScan {
  id         String         @id @default(uuid())
  ticketId   String
  ticket     Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  staffId    String
  staff      User           @relation(fields: [staffId], references: [id])
  scanTime   DateTime       @default(now())
  result     GateScanResult
  gateNumber String?
  notes      String?

  @@index([ticketId])
  @@index([staffId])
}

/// Every gate scan, admitted or not (audit trail and fraud evidence). ticketId is null for junk QRs.
model CheckIn {
  id        String        @id @default(uuid())
  ticketId  String?
  ticket    Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  eventId   String
  staffId   String
  staff     User          @relation("StaffCheckIns", fields: [staffId], references: [id])
  deviceId  String?
  gate      String?
  result    CheckInResult
  reason    String
  offline   Boolean       @default(false)
  conflict  Boolean       @default(false) // two devices admitted the same ticket while offline
  scannedAt DateTime      @default(now())
  syncedAt  DateTime?
  createdAt DateTime      @default(now())

  @@index([eventId, scannedAt])
  @@index([ticketId])
  @@index([staffId])
}

model BehaviorEvent {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String
  action    String   // event_view, seat_selected, checkout_started, etc.
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([userId])
}

enum TransferType {
  DIRECT_TRANSFER
  P2P_RESALE
}

model TicketTransferHistory {
  id           String        @id @default(uuid())
  ticketId     String
  ticket       Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromUserId   String
  fromUser     User          @relation("TransfersSent", fields: [fromUserId], references: [id])
  toUserId     String
  toUser       User          @relation("TransfersReceived", fields: [toUserId], references: [id])
  transferType TransferType  @default(DIRECT_TRANSFER)
  price        Decimal?      @db.Decimal(10, 2)
  oldNonce     String?
  newNonce     String?
  txHash       String?
  createdAt    DateTime      @default(now())

  @@index([ticketId])
  @@index([fromUserId])
  @@index([toUserId])
}

model Waitlist {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// Events a user saved with the heart (each user sees and edits only their own)
model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId, createdAt])
}
