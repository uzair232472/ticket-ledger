// TicketLedger Prisma Schema
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ORGANIZER
  GATE_STAFF
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
  FROZEN
  BLACKLISTED
}

enum OtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum InviteStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum EventType {
  CRICKET_MATCH
  FOOTBALL_MATCH
  KABADDI
  BOXING
  MUSIC_CONCERT
  MUSIC_FESTIVAL
  HOCKEY_MATCH
  QAWWALI
  THEATRE
  CONFERENCE
  GENERAL_ADMISSION
  OTHER // an organizer-added category, named by Event.customCategory (the list above stays fixed)
}

// Categories organizers add when none of the predefined EventType values fits. Shared, so the next organizer
// can pick an existing one; a name that matches a predefined category is refused.
model CustomCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  createdById String?
  createdAt   DateTime @default(now())

  events Event[]
}

// What a Seat row represents: a numbered seat, an unnumbered general-admission place, or a table seat
enum SeatKind {
  SEAT
  GA_SLOT
  TABLE_SEAT
}

enum VenueLayoutStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EventStatus {
  DRAFT
  PRELAUNCH_ANALYSIS
  PENDING_APPROVAL // sent to TicketLedger admins; not public until approved
  REJECTED // returned by an admin with a comment; the organizer can fix and resubmit
  PUBLISHED
  PAUSED
  COMPLETED
  CANCELLED
}

// Organizer promotion requests (top of listings, home hero banner), decided by a Super Admin
enum PromotionStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
}

enum SeatStatus {
  AVAILABLE
  LOCKED
  SOLD
  BLOCKED
}

enum OrderStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED // every ticket in the order was refunded
  PARTIALLY_REFUNDED // some tickets were refunded, the rest are still valid
}

// Money returned to whoever paid for a ticket (the order's buyer, or the fan who bought it on resale)
enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum RefundReason {
  EVENT_CANCELLED // the organizer or an admin cancelled the event
  RESCHEDULE_OPT_OUT // the holder can't make the new date or venue
  POSTPONED_OPT_OUT // the holder didn't want to wait for a new date
  ADMIN // issued by a TicketLedger admin
}

// An organizer's request to move an event that already has ticket holders
enum ScheduleChangeStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum PaymentMethod {
  STRIPE
  JAZZCASH
  EASYPAISA
  MOCK
}

enum TicketStatus {
  ACTIVE
  SCANNED
  TRANSFERRED
  RESOLD
  CANCELLED
}

enum GateScanResult {
  VALID_FIRST_SCAN
  ALREADY_SCANNED
  INVALID_SCAN
}

enum CheckInResult {
  GREEN
  YELLOW
  RED
}

enum ResaleStatus {
  ACTIVE
  SOLD
  CANCELLED
  PAUSED // the event was rescheduled: the seller relists it (with the new date) or takes a refund
}

model User {
  id                 String        @id @default(uuid())
  email              String        @unique
  phone              String? // not unique: one number may be used by several accounts (e.g. customer + organizer)
  passwordHash       String
  name               String
  role               Role          @default(CUSTOMER)
  status             AccountStatus @default(PENDING_VERIFICATION)
  walletAddress      String?       @unique
  // Organizers: the company they own. Gate staff: the company whose events they work.
  companyId          String?
  memberOfCompany    Company?      @relation("CompanyMembers", fields: [companyId], references: [id], onDelete: SetNull)
  emailVerifiedAt    DateTime?
  otpCode            String?
  otpExpiresAt       DateTime?
  isVerified         Boolean       @default(false)
  city               String?       @default("Lahore")
  // Profile extras (per account; previously kept in the browser and shared by everyone using it)
  avatarUrl          String?
  salutation         String?
  organisation       String?
  emailNotifications Boolean       @default(true)
  pushNotifications  Boolean       @default(true)
  smsNotifications   Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  company            Company?
  orders             Order[]
  otpCodes           OtpCode[]
  refreshTokens      RefreshToken[]
  invitesSent        StaffInvite[]           @relation("InvitesSent")
  staffAssignments   StaffEventAssignment[]  @relation("StaffAssignments")
  assignmentsCreated StaffEventAssignment[]  @relation("AssignmentsCreated")
  tickets            Ticket[]
  scansPerformed     GateScan[]
  checkInsPerformed  CheckIn[]               @relation("StaffCheckIns")
  ticketsCheckedIn   Ticket[]                @relation("TicketCheckIns")
  behaviorEvents     BehaviorEvent[]
  notifications      Notification[]
  wishlistItems      WishlistItem[]
  auditLogs          AuditLog[]
  resaleListings     ResaleListing[]         @relation("SellerListings")
  transfersSent      TicketTransferHistory[] @relation("TransfersSent")
  transfersReceived  TicketTransferHistory[] @relation("TransfersReceived")
  waitlistEntries    Waitlist[]
  refundsReceived    Refund[]                @relation("RefundsReceived")

  @@index([role])
  @@index([status])
  @@index([companyId])
}

model OtpCode {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId, purpose])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model StaffInvite {
  id          String       @id @default(uuid())
  email       String
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User         @relation("InvitesSent", fields: [invitedById], references: [id])
  tokenHash   String       @unique
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([email])
  @@index([companyId])
  @@index([eventId])
}

model StaffEventAssignment {
  staffId      String
  staff        User     @relation("StaffAssignments", fields: [staffId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User     @relation("AssignmentsCreated", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  @@id([staffId, eventId])
  @@index([eventId])
}

model Company {
  id              String        @id @default(uuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  ownerName       String
  phone           String
  email           String
  city            String
  ntnCnic         String
  documentUrl     String // first verification document (kept for single-link screens)
  documentUrls    String[]      @default([]) // all verification documents, 1 to 4
  status          CompanyStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  events        Event[]
  prebookDrafts PrebookDraft[]
  members       User[]         @relation("CompanyMembers")
  staffInvites  StaffInvite[]

  @@index([status])
}

model Event {
  id                   String          @id @default(uuid())
  companyId            String
  company              Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                 String
  description          String
  type                 EventType
  // Set when type is OTHER; categoryLabel copies its name so every page can show it without a join
  customCategoryId     String?
  customCategory       CustomCategory? @relation(fields: [customCategoryId], references: [id])
  categoryLabel        String?
  status               EventStatus     @default(DRAFT)
  date                 DateTime
  time                 String
  // Exact schedule (Pakistan time entered by the organizer, stored as instants). `date` and `time` above
  // stay the start as shown to attendees. Null only on events saved before end times existed.
  startsAt             DateTime?
  endsAt               DateTime?
  // Set once the venue slot is secured (admin approval). Only then is the date shown as "Reserved".
  reservedAt           DateTime?
  // Kept off public pages and new sales by the organizer. The slot stays held and sold tickets stay valid.
  isHidden             Boolean         @default(false)
  // Dates submitted from a prebooking form: one event per form row, so a retried submit never duplicates one
  prebookDraftId       String?
  prebookDraft         PrebookDraft?   @relation(fields: [prebookDraftId], references: [id], onDelete: SetNull)
  prebookRowKey        String?
  city                 String
  venue                String
  // Exact venue location picked on the map by the organizer (home map pin, "Open in Google Maps")
  latitude             Float?
  longitude            Float?
  locationAddress      String?
  // Where attendees reach the organizer about this event (falls back to the organizer's company email)
  contactEmail         String?
  bannerUrl            String?
  // Organizer-managed media (all optional; the web app falls back to bannerUrl / category artwork)
  cardImageUrl         String?
  galleryWideUrl       String?
  // Admin review: set when the organizer submits and when an admin approves or rejects
  submittedAt          DateTime?
  approvedAt           DateTime?
  reviewedAt           DateTime?
  reviewedBy           String?
  reviewComment        String?
  // Promotion requests. Priority lists the event above the others on discovery pages; hero puts it in the
  // home page hero (its promo video, or its banner when no video was given). Both apply only while the
  // event is on sale, and only once an admin approves them.
  priorityStatus       PromotionStatus @default(NONE)
  priorityRequestedAt  DateTime?
  heroStatus           PromotionStatus @default(NONE)
  heroRequestedAt      DateTime?
  heroVideoUrl         String?
  heroVideoMobileUrl   String?
  promotionNote        String? // the organizer's message with the request
  promotionComment     String? // the admin's reply
  promotionReviewedAt  DateTime?
  // Cancellation, postponement and rescheduling (refunds are in Refund)
  cancelledAt          DateTime?
  cancelReason         String?
  postponedAt          DateTime? // sales paused with no new date yet; holders can get a refund any time
  postponeReason       String?
  rescheduledAt        DateTime?
  refundWindowEndsAt   DateTime? // after a reschedule: holders can ask for a refund until then
  refundReminderSentAt DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  galleryImages    EventGalleryImage[]
  venueLayouts     VenueLayout[]
  tiers            TicketTier[]
  seats            Seat[]
  orders           Order[]
  tickets          Ticket[]
  wishlistItems    WishlistItem[]
  behaviorEvents   BehaviorEvent[]
  waitlist         Waitlist[]
  staffInvites     StaffInvite[]
  staffAssignments StaffEventAssignment[]
  refunds          Refund[]
  scheduleChanges  EventScheduleChange[]

  @@unique([prebookDraftId, prebookRowKey])
  @@index([city])
  @@index([city, endsAt])
  @@index([type])
  @@index([status])
  @@index([companyId, createdAt])
}

// Ordered photos for the event page's scrolling gallery strip
model EventGalleryImage {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url       String
  position  Int
  createdAt DateTime @default(now())

  @@index([eventId, position])
}

model TicketTier {
  id                String   @id @default(uuid())
  eventId           String
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name              String
  price             Decimal  @db.Decimal(10, 2)
  totalQuantity     Int
  availableQuantity Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  seats Seat[]

  @@index([eventId])
}

model Seat {
  id             String     @id @default(uuid())
  eventId        String
  event          Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tierId         String
  tier           TicketTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  section        String
  row            String
  seatNumber     String
  status         SeatStatus @default(AVAILABLE)
  lockedUntil    DateTime?
  lockedByUserId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Venue layout link (null for seats from the older grid generator)
  layoutKey  String?
  sectionKey String?
  kind       SeatKind @default(SEAT)
  tableKey   String?
  wholeTable Boolean  @default(false)

  ticket Ticket?

  @@unique([eventId, section, row, seatNumber])
  @@unique([eventId, layoutKey])
  @@index([eventId, status])
  @@index([eventId, sectionKey])
  @@index([eventId, tableKey])
}

// Organizer-designed venue plan. One DRAFT per event is edited freely; publishing validates it against
// held/sold seats, syncs Seat rows and makes it the PUBLISHED version (the previous one is ARCHIVED).
model VenueLayout {
  id          String            @id @default(uuid())
  eventId     String
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status      VenueLayoutStatus @default(DRAFT)
  version     Int               @default(1)
  template    String?
  data        Json
  createdById String?
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([eventId, status])
}

model Order {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  eventId       String
  event         Event         @relation(fields: [eventId], references: [id])
  totalAmount   Decimal       @db.Decimal(10, 2)
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(MOCK)
  paymentTxId   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tickets Ticket[]
  refunds Refund[]

  @@index([userId])
  @@index([status])
}

// One refund per ticket. `userId` is who gets the money: the order's buyer, or the resale buyer when the
// ticket was last bought on resale (they get the resale price back).
model Refund {
  id              String         @id @default(uuid())
  ticketId        String         @unique
  ticket          Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  eventId         String
  event           Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation("RefundsReceived", fields: [userId], references: [id])
  orderId         String?
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  resaleListingId String?
  amount          Decimal        @db.Decimal(10, 2)
  // What the organizer pays back (face value); the rest of a resale price is covered by TicketLedger
  organizerShare  Decimal        @db.Decimal(10, 2)
  reason          RefundReason
  status          RefundStatus   @default(PENDING)
  method          PaymentMethod?
  paymentTxId     String? // the original payment the refund is sent against
  providerRef     String?
  failureReason   String?
  attempts        Int            @default(0)
  processedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([eventId])
  @@index([userId])
  @@index([status])
}

// A date, time or venue change for an event with ticket holders: reviewed by an admin unless it is minor
// (same venue and day, start moved by two hours or less). The old values are kept for the "was / now" notice.
model EventScheduleChange {
  id                 String               @id @default(uuid())
  eventId            String
  event              Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requestedById      String
  status             ScheduleChangeStatus @default(PENDING)
  minor              Boolean              @default(false)
  reason             String
  oldDate            DateTime
  oldTime            String
  oldStartsAt        DateTime?
  oldEndsAt          DateTime?
  oldCity            String
  oldVenue           String
  newDate            DateTime
  newTime            String
  newStartsAt        DateTime
  newEndsAt          DateTime
  newCity            String
  newVenue           String
  newLatitude        Float?
  newLongitude       Float?
  newLocationAddress String?
  reviewComment      String?
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime             @default(now())

  @@index([eventId, status])
  @@index([status])
}

model Ticket {
  id      String       @id @default(uuid())
  orderId String
  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventId String
  event   Event        @relation(fields: [eventId], references: [id])
  seatId  String       @unique
  seat    Seat         @relation(fields: [seatId], references: [id])
  userId  String
  user    User         @relation(fields: [userId], references: [id])
  price   Decimal      @db.Decimal(10, 2)
  status  TicketStatus @default(ACTIVE)

  // Blockchain metadata
  tokenId         Int?
  txHash          String?
  contractAddress String?
  ownerWallet     String?

  // Dynamic secure QR metadata
  qrNonce       String    @default(uuid())
  qrIssuedAt    DateTime  @default(now())
  qrSignature   String?
  qrVersion     Int       @default(1) // +1 on every transfer / resale: the old owner's QR stops working
  // Short code printed under the QR for when the camera fails (rotated with qrVersion)
  manualCode    String?   @unique
  // Gate check-in (status ACTIVE = valid, SCANNED = used)
  checkedInAt   DateTime?
  checkedInById String?
  checkedInBy   User?     @relation("TicketCheckIns", fields: [checkedInById], references: [id])
  gate          String?
  pdfUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scans           GateScan[]
  checkIns        CheckIn[]
  resaleListings  ResaleListing[]
  transferHistory TicketTransferHistory[]
  refund          Refund?

  @@index([userId])
  @@index([eventId])
  @@index([status])
}

model ResaleListing {
  id             String       @id @default(uuid())
  ticketId       String
  ticket         Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sellerId       String
  seller         User         @relation("SellerListings", fields: [sellerId], references: [id])
  buyerId        String?
  originalPrice  Decimal      @db.Decimal(10, 2)
  resalePrice    Decimal      @db.Decimal(10, 2)
  maxResalePrice Decimal      @db.Decimal(10, 2) // enforced <= 1.10 * originalPrice
  status         ResaleStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
  @@index([ticketId])
}

model GateScan {
  id         String         @id @default(uuid())
  ticketId   String
  ticket     Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  staffId    String
  staff      User           @relation(fields: [staffId], references: [id])
  scanTime   DateTime       @default(now())
  result     GateScanResult
  gateNumber String?
  notes      String?

  @@index([ticketId])
  @@index([staffId])
}

/// Every gate scan, admitted or not (audit trail and fraud evidence). ticketId is null for junk QRs.
model CheckIn {
  id        String        @id @default(uuid())
  ticketId  String?
  ticket    Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  eventId   String
  staffId   String
  staff     User          @relation("StaffCheckIns", fields: [staffId], references: [id])
  deviceId  String?
  gate      String?
  result    CheckInResult
  reason    String
  offline   Boolean       @default(false)
  conflict  Boolean       @default(false) // two devices admitted the same ticket while offline
  scannedAt DateTime      @default(now())
  syncedAt  DateTime?
  createdAt DateTime      @default(now())

  @@index([eventId, scannedAt])
  @@index([ticketId])
  @@index([staffId])
}

model BehaviorEvent {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String
  action    String // event_view, seat_selected, checkout_started, etc.
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  link      String? // in-app path the notification (and its email button) opens, e.g. /events/:id/refund
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([userId])
}

enum TransferType {
  DIRECT_TRANSFER
  P2P_RESALE
}

model TicketTransferHistory {
  id           String       @id @default(uuid())
  ticketId     String
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromUserId   String
  fromUser     User         @relation("TransfersSent", fields: [fromUserId], references: [id])
  toUserId     String
  toUser       User         @relation("TransfersReceived", fields: [toUserId], references: [id])
  transferType TransferType @default(DIRECT_TRANSFER)
  price        Decimal?     @db.Decimal(10, 2)
  oldNonce     String?
  newNonce     String?
  txHash       String?
  createdAt    DateTime     @default(now())

  @@index([ticketId])
  @@index([fromUserId])
  @@index([toUserId])
}

model Waitlist {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// Events a user saved with the heart (each user sees and edits only their own)
model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId, createdAt])
}

// An organizer's prebooking form (shared details, one row per date, per-date customizations), autosaved so
// it can be finished later. Submitted rows become Event records linked back here by prebookRowKey.
model PrebookDraft {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById String
  title       String   @default("")
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events Event[]

  @@index([companyId, updatedAt])
}
