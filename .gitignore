*.sqlite
*.sqlite3
*.db
pgdata/
redisdata/

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vs/
node_modules/
.env

# QR pass signing key (development; production uses QR_SIGNING_PRIVATE_KEY)
apps/api/.keys/

# User uploads (company documents, avatars, event media) stay on the server
apps/api/uploads/
apps/api/private_uploads/

# ML training exports and candidates built from the client's database (never commit client data)
apps/ml-service/exports/
apps/ml-service/models/candidates/
apps/ml-service/reports/candidates/
# PUBLIC datasets: re-fetched with apps/ml-service/scripts/fetch_public_datasets.py (sources, licenses, checksums there)
apps/ml-service/data/public/*/
